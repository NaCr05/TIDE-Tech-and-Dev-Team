POSTGRES_USER=postgres
POSTGRES_PASSWORD=password
POSTGRES_DB=tide_final
POSTGRES_PORT=5434

BACKEND_PORT=3001
FRONTEND_PORT=5173
AGENT_PORT=8000
FRONTEND_ORIGIN=http://localhost:5173

AGENT_MODE=mock
DEEPSEEK_API_KEY=your_api_key_here
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-pro

MATTERMOST_SLASH_TOKEN=replace_with_mattermost_token
MATTERMOST_TEACHER_USERNAME=your_mattermost_teacher_username
# 可选：Mattermost Server 能访问到的完整交互回调地址。
# 留空时，后端会根据 Slash Command 请求的 Host 自动生成。
MATTERMOST_ACTION_URL=

# 默认不记录 Docker 每 5 秒一次的 /health 请求，避免日志噪音。
LOG_HEALTH_REQUESTS=false

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum TaskStatus {
  todo
  doing
  done
}

enum TaskPriority {
  low
  medium
  high
}

enum UserRole {
  teacher
  student
}

enum AssignmentStatus {
  published
  closed
}

enum SubmissionStatus {
  submitted
  evaluating
  evaluated
  failed
}

enum EvaluationStatus {
  generated
  confirmed
  modified
  regrading
  failed
}

enum CompletenessLevel {
  complete
  partial
  incomplete
}

enum CorrectnessLevel {
  correct
  mostly_correct
  partially_correct
  incorrect
  uncertain
}

enum EvaluationGrade {
  A
  B
  C
  D
  F
}

enum EvaluationAuditAction {
  baseline
  generated
  regraded
  confirmed
  modified
}

model User {
  id               String            @id @default(cuid())
  mattermostUserId String?           @unique
  username         String            @unique
  displayName      String
  email            String?           @unique
  role             UserRole          @default(student)
  tasks            Task[]
  comments         Comment[]
  assignments      Assignment[]      @relation("AssignmentCreator")
  submissions      Submission[]      @relation("StudentSubmissions")
  reviewedResults  Evaluation[]      @relation("EvaluationReviewer")
  evaluationAudits EvaluationAudit[] @relation("EvaluationAuditActor")
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
}

model Assignment {
  id           String           @id @default(cuid())
  title        String
  question     String           @db.Text
  deadline     DateTime
  instructions String?          @db.Text
  status       AssignmentStatus @default(published)
  createdById  String
  createdBy    User             @relation("AssignmentCreator", fields: [createdById], references: [id], onDelete: Restrict)
  submissions  Submission[]
  createdAt    DateTime         @default(now())
  updatedAt    DateTime         @updatedAt

  @@index([createdById])
  @@index([status, deadline])
}

model Submission {
  id               String            @id @default(cuid())
  assignmentId     String
  studentId        String
  answer           String            @db.Text
  status           SubmissionStatus  @default(submitted)
  submittedAt      DateTime          @default(now())
  assignment       Assignment        @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student          User              @relation("StudentSubmissions", fields: [studentId], references: [id], onDelete: Restrict)
  evaluation       Evaluation?
  evaluationAudits EvaluationAudit[]
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt

  @@unique([assignmentId, studentId])
  @@index([assignmentId, status])
  @@index([studentId])
}

model Evaluation {
  id                  String            @id @default(cuid())
  submissionId        String            @unique
  completenessLevel   CompletenessLevel
  completenessComment String            @db.Text
  correctnessLevel    CorrectnessLevel
  correctnessComment  String            @db.Text
  mainProblems        Json
  suggestions         Json
  score               Int
  grade               EvaluationGrade
  status              EvaluationStatus  @default(generated)
  agentRawOutput      String?           @db.Text
  errorMessage        String?           @db.Text
  version             Int               @default(1)
  reviewedById        String?
  reviewedAt          DateTime?
  submission          Submission        @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  reviewedBy          User?             @relation("EvaluationReviewer", fields: [reviewedById], references: [id], onDelete: SetNull)
  audits              EvaluationAudit[]
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt

  @@index([status])
  @@index([reviewedById])
}

model EvaluationAudit {
  id             String                @id @default(cuid())
  evaluationId   String?
  submissionId   String
  action         EvaluationAuditAction
  version        Int
  snapshot       Json
  actorId        String?
  agentRawOutput String?               @db.Text
  evaluation     Evaluation?           @relation(fields: [evaluationId], references: [id], onDelete: SetNull)
  submission     Submission            @relation(fields: [submissionId], references: [id], onDelete: Cascade)
  actor          User?                 @relation("EvaluationAuditActor", fields: [actorId], references: [id], onDelete: SetNull)
  createdAt      DateTime              @default(now())

  @@index([evaluationId, createdAt])
  @@index([submissionId, createdAt])
  @@index([actorId])
}

model Project {
  id          String   @id @default(cuid())
  name        String
  description String?
  tasks       Task[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Task {
  id          String       @id @default(cuid())
  title       String
  description String?
  status      TaskStatus   @default(todo)
  priority    TaskPriority @default(medium)
  deadline    DateTime?

  projectId  String
  assigneeId String

  project  Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assignee User      @relation(fields: [assigneeId], references: [id], onDelete: Restrict)
  comments Comment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([projectId])
  @@index([assigneeId])
}

model Comment {
  id      String @id @default(cuid())
  content String

  taskId String
  userId String

  task Task @relation(fields: [taskId], references: [id], onDelete: Cascade)
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([taskId])
  @@index([userId])
}

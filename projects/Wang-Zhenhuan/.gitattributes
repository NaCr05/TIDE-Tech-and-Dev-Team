* text=auto

# Linux containers and cross-platform source files use LF.
.gitattributes text eol=lf
.gitignore text eol=lf
*.md text eol=lf
Dockerfile text eol=lf
*.dockerignore text eol=lf
*.py text eol=lf
*.ts text eol=lf
*.tsx text eol=lf
*.js text eol=lf
*.mjs text eol=lf
*.json text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.sql text eol=lf
*.toml text eol=lf
*.prisma text eol=lf

# PowerShell scripts are primarily run from Windows in this project.
*.ps1 text eol=crlf
